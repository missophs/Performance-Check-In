{
  "type": "modal",
  "callback_id": "pci_save",
  "private_metadata": "{\"table\":\"goals\",\"id\":\"11111111-1111-4111-8111-111111111111\"}",
  "title": {
    "type": "plain_text",
    "text": "New goal"
  },
  "submit": {
    "type": "plain_text",
    "text": "Save"
  },
  "close": {
    "type": "plain_text",
    "text": "Cancel"
  },
  "blocks": [
    {
      "type": "section",
      "text": {
        "type": "mrkdwn",
        "text": "*Start with what matters*\nTurn priorities into clear goals and track your progress."
      }
    },
    {
      "type": "context",
      "elements": [
        {
          "type": "plain_text",
          "text": "🤝 Shared with the manager and employee in this relationship."
        }
      ]
    },
    {
      "type": "divider"
    },
    {
      "type": "input",
      "block_id": "pair",
      "label": {
        "type": "plain_text",
        "text": "Who is this for?"
      },
      "hint": {
        "type": "plain_text",
        "text": "Choose your manager or employee."
      },
      "element": {
        "type": "external_select",
        "action_id": "pci_pair",
        "min_query_length": 0,
        "placeholder": {
          "type": "plain_text",
          "text": "Choose a working relationship"
        }
      }
    },
    {
      "type": "input",
      "block_id": "title",
      "label": {
        "type": "plain_text",
        "text": "Title"
      },
      "optional": false,
      "element": {
        "type": "plain_text_input",
        "action_id": "value",
        "multiline": false,
        "max_length": 200,
        "placeholder": {
          "type": "plain_text",
          "text": "Give this a short, clear title"
        }
      }
    },
    {
      "type": "input",
      "block_id": "description",
      "label": {
        "type": "plain_text",
        "text": "Description"
      },
      "optional": true,
      "element": {
        "type": "plain_text_input",
        "action_id": "value",
        "multiline": true,
        "max_length": 2000,
        "placeholder": {
          "type": "plain_text",
          "text": "What would success look like?"
        }
      }
    },
    {
      "type": "input",
      "block_id": "status",
      "label": {
        "type": "plain_text",
        "text": "Status"
      },
      "optional": false,
      "element": {
        "type": "static_select",
        "action_id": "value",
        "options": [
          {
            "text": {
              "type": "plain_text",
              "text": "Active"
            },
            "value": "active"
          },
          {
            "text": {
              "type": "plain_text",
              "text": "Completed"
            },
            "value": "completed"
          },
          {
            "text": {
              "type": "plain_text",
              "text": "Paused"
            },
            "value": "paused"
          },
          {
            "text": {
              "type": "plain_text",
              "text": "Cancelled"
            },
            "value": "cancelled"
          }
        ]
      }
    },
    {
      "type": "input",
      "block_id": "target_date",
      "label": {
        "type": "plain_text",
        "text": "Target date"
      },
      "optional": true,
      "element": {
        "type": "datepicker",
        "action_id": "value"
      }
    },
    {
      "type": "input",
      "block_id": "progress_note",
      "label": {
        "type": "plain_text",
        "text": "Progress so far"
      },
      "optional": true,
      "element": {
        "type": "plain_text_input",
        "action_id": "value",
        "multiline": true,
        "max_length": 2000
      }
    }
  ]
}
